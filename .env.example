# Copy to .env. Prisma resolves this path relative to prisma/schema.prisma; it works on Windows, macOS and Linux.
DATABASE_URL=file:../db/custom.db

# Set to 1 only when running behind a trusted reverse proxy (Caddy/nginx)
# that overwrites X-Forwarded-For. Otherwise rate limiting ignores that header.
# TRUST_PROXY=1

# Optional: lets non-owner admins edit data providers (X-Admin-Token header)
# ADMIN_TOKEN=
